@{
    ViewData["Title"] = "Inicio";
}
<div id="carruselInicio" class="carousel slide mb-4 shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        @for (int i = 0; i < 4; i++)
        {
            <button type="button" data-bs-target="#carruselInicio" data-bs-slide-to="@i"
                    class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)"
                    aria-label="Diapositiva @(i + 1)"></button>
        }
    </div>
    <div class="carousel-inner">
        @for (int i = 1; i <= 4; i++)
        {
            <div class="carousel-item @(i == 1 ? "active" : null)">
                <img src="~/images/carrusel@(i).webp" class="d-block w-100 carrusel-img" alt="Promoción @i" />
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carruselInicio" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carruselInicio" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<div class="text-center">
    <h1 class="display-6">Bienvenido a Dima</h1>
    <p class="lead text-body-secondary">Tu catálogo de productos en línea.</p>
    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-lg btn-primary" href="~/Productos"><i class="bi bi-gear"></i> Administrar catálogo</a>
    }
    else if (User.IsInRole("Usuario"))
    {
        <a class="btn btn-lg btn-primary" href="~/Comprar"><i class="bi bi-cart"></i> Comenzar a comprar</a>
    }
    else
    {
        <a class="btn btn-lg btn-primary" href="~/Auth"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a>
    }
</div>
