@model List<Producto>
@{
    ViewData["Title"] = "Productos";
    string? busqueda = ViewData["Busqueda"] as string;
    var nombres = ViewData["NombresArchivos"] as Dictionary<int, string> ?? [];
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-box-seam"></i> Productos</h1>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <input type="search" name="s" value="@busqueda" class="form-control" maxlength="255"
               placeholder="Buscar por título" aria-label="Buscar productos" />
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Buscar</button>
        @if (busqueda is not null)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
        }
    </div>
</form>

<partial name="_MensajesPartial" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (busqueda is not null)
{
    <p class="text-body-secondary">Resultados para «<span class="text-break">@busqueda</span>»: @Model.Count</p>
}

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No se encontraron productos.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Portada</th>
                    <th scope="col">Título</th>
                    <th scope="col" class="text-end">Precio</th>
                    <th scope="col">Categorías</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    string? v = p.ArchivoId is int aid && nombres.TryGetValue(aid, out var n) ? n : null;
                    <tr>
                        <td>@p.ProductoId</td>
                        <td><partial name="_PortadaPartial" model="p" view-data='new ViewDataDictionary(ViewData) { ["v"] = v }' /></td>
                        <td class="text-break">@p.Titulo</td>
                        <td class="text-end text-nowrap">@Producto.FormatoPrecio(p.Precio)</td>
                        <td><partial name="_CategoriasListadoPartial" model="p.Categorias" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@p.ProductoId" title="Detalle"><i class="bi bi-eye"></i><span class="visually-hidden">Detalle</span></a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.ProductoId" title="Editar"><i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span></a>
                            <a class="btn btn-sm btn-outline-info" asp-action="Categorias" asp-route-id="@p.ProductoId" title="Categorías"><i class="bi bi-tags"></i><span class="visually-hidden">Categorías</span></a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@p.ProductoId" title="Eliminar"><i class="bi bi-trash"></i><span class="visually-hidden">Eliminar</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
