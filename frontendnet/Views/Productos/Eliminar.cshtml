@model Producto
@{
    ViewData["Title"] = "Eliminar producto";
}
<h1 class="h3 mb-4"><i class="bi bi-trash"></i> Eliminar producto</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>
<p class="text-danger">¿Está seguro de que desea eliminar este producto? Esta acción no se puede deshacer.</p>
<form asp-action="Eliminar" asp-route-id="@Model.ProductoId" method="post">
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
