@model Producto
@{
    ViewData["Title"] = "Editar producto";
}
<h1 class="h3 mb-4"><i class="bi bi-pencil"></i> Editar producto</h1>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.ProductoId" method="post">
            <div class="mb-3">
                <label asp-for="ProductoId" class="form-label"></label>
                <input asp-for="ProductoId" class="form-control" readonly disabled />
            </div>
            <partial name="_FormularioPartial" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.ProductoId">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto_portada.js" asp-append-version="true"></script>
}
