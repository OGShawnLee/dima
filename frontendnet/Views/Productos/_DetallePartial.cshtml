@model Producto
@{
    var nombres = ViewData["NombresArchivos"] as Dictionary<int, string> ?? [];
    string? v = Model.ArchivoId is int aid && nombres.TryGetValue(aid, out var n) ? n : null;
}
<div class="row g-4">
    <div class="col-md-8">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ProductoId)</dt>
            <dd class="col-sm-9">@Model.ProductoId</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Titulo)</dt>
            <dd class="col-sm-9 text-break">@Model.Titulo</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Descripcion)</dt>
            <dd class="col-sm-9 text-break">@Model.Descripcion</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Precio)</dt>
            <dd class="col-sm-9">@Producto.FormatoPrecio(Model.Precio)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Categorias)</dt>
            <dd class="col-sm-9"><partial name="_CategoriasListadoPartial" model="Model.Categorias" /></dd>
        </dl>
    </div>
    <div class="col-md-4">
        <partial name="_PortadaPartial" model="Model"
                 view-data='new ViewDataDictionary(ViewData) { ["clase"] = "img-fluid rounded border", ["ancho"] = "300", ["v"] = v }' />
    </div>
</div>
