@model Upload
@{
    ViewData["Title"] = "Subir imagen";
}
<h1 class="h3 mb-4"><i class="bi bi-upload"></i> Subir imagen</h1>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Crear" method="post" enctype="multipart/form-data">
            <partial name="_FormularioPartial" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Subir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/portada.js" asp-append-version="true"></script>
}
