@model List<Archivo>
@{
    ViewData["Title"] = "Archivos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-images"></i> Archivos</h1>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-upload"></i> Subir imagen</a>
</div>

<partial name="_MensajePartial" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No hay imágenes registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Portada</th>
                    <th>Nombre</th>
                    <th>Tamaño</th>
                    <th>Repositorio</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ArchivoId</td>
                        <td>
                            <img src="@Url.Action("Imagen", "Archivos", new { id = item.ArchivoId, v = item.Nombre })"
                                 alt="Imagen @item.ArchivoId" class="img-thumbnail" width="80" loading="lazy" />
                        </td>
                        <td class="text-break">@item.Nombre</td>
                        <td>@(((item.Size ?? 0) / 1024.0).ToString("0.#")) KB</td>
                        <td>@(item.InDb ? "Base de datos" : "Disco")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Detalle" asp-route-id="@item.ArchivoId" class="btn btn-sm btn-outline-secondary" title="Detalle"><i class="bi bi-eye"></i></a>
                            <a asp-action="Editar" asp-route-id="@item.ArchivoId" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Eliminar" asp-route-id="@item.ArchivoId" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
