@model Archivo
@{
    ViewData["Title"] = "Detalle de imagen";
}
<h1 class="h3 mb-4"><i class="bi bi-image"></i> Detalle de imagen</h1>
<partial name="_MensajePartial" />
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>
<a asp-action="Editar" asp-route-id="@Model.ArchivoId" class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
