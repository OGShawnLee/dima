@model Archivo
@{
    ViewData["Title"] = "Eliminar imagen";
}
<h1 class="h3 mb-4"><i class="bi bi-trash"></i> Eliminar imagen</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="alert alert-warning" role="alert">¿Está seguro de que desea eliminar esta imagen? Esta acción no se puede deshacer.</div>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>
<form asp-action="Eliminar" asp-route-id="@Model.ArchivoId" method="post" class="d-inline">
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
</form>
<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
