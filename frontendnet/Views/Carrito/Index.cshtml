@model CarritoViewModel
@{
    ViewData["Title"] = "Carrito";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-cart3"></i> Carrito</h1>
    <a class="btn btn-outline-primary" asp-controller="Comprar" asp-action="Index"><i class="bi bi-shop"></i> Seguir comprando</a>
</div>

<partial name="_MensajesPartial" />
@foreach (var aviso in Model.Avisos)
{
    <div class="alert alert-warning" role="status">@aviso</div>
}
@if (Model.PreciosNoDisponibles)
{
    <div class="alert alert-danger" role="alert">
        No fue posible obtener los precios actuales. Su carrito se conserva; inténtelo más tarde.
    </div>
}

<p class="text-body-secondary">Mostrando @Model.Elementos elementos (@Model.Unidades unidades con precio disponible).</p>

@if (Model.Lineas.Count == 0)
{
    @if (!Model.PreciosNoDisponibles)
    {
        <p class="text-body-secondary">Su carrito está vacío.</p>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Portada</th>
                    <th scope="col">Producto</th>
                    <th scope="col" class="text-end">Precio</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col" class="text-end">Subtotal</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lineas)
                {
                    int pid = l.Producto.ProductoId ?? 0;
                    <tr>
                        <td><partial name="_PortadaPartial" model="l.Producto" /></td>
                        <td class="text-break">@l.Producto.Titulo</td>
                        <td class="text-end text-nowrap">@Producto.FormatoPrecio(l.Producto.Precio)</td>
                        <td>
                            <form asp-action="Actualizar" method="post" class="d-flex gap-1">
                                <input type="hidden" name="productoId" value="@pid" />
                                <input type="number" name="cantidad" value="@l.Cantidad" min="1" max="99" step="1" required
                                       class="form-control form-control-sm w-auto" aria-label="Cantidad de @l.Producto.Titulo" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Actualizar cantidad"><i class="bi bi-arrow-repeat"></i><span class="visually-hidden">Actualizar</span></button>
                            </form>
                        </td>
                        <td class="text-end text-nowrap">@Producto.FormatoPrecio(l.Subtotal)</td>
                        <td class="text-end">
                            <form asp-action="Quitar" method="post">
                                <input type="hidden" name="productoId" value="@pid" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Quitar"><i class="bi bi-trash"></i><span class="visually-hidden">Quitar</span></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="4" class="text-end">Total estimado</th>
                    <td class="text-end text-nowrap fw-bold">@Producto.FormatoPrecio(Model.Total)</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="small text-body-secondary">Los precios son informativos; el total definitivo se calcula al confirmar el pedido.</p>
}

@if (Model.Elementos > 0)
{
    <div class="d-flex flex-wrap justify-content-end gap-2">
        <form asp-action="Vaciar" method="post">
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Vaciar carrito</button>
        </form>
        @* Checkout (F007, PedidosController.Confirmar): posts no fields besides the antiforgery token
           appended by the form tag helper (asp-* attributes are required for that; a literal action
           attribute suppresses it); the cart is read from the session server-side. *@
        <form asp-controller="Pedidos" asp-action="Confirmar" method="post">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-bag-check"></i> Confirmar compra
            </button>
        </form>
    </div>
}
