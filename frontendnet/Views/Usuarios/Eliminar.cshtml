@model Usuario
@{
    ViewData["Title"] = "Eliminar usuario";
    bool puedeEditar = ViewBag.PuedeEditar is true;
}
<h1 class="h3 mb-4"><i class="bi bi-trash"></i> Eliminar usuario</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>
@if (!puedeEditar)
{
    <partial name="_PropiaCuentaPartial" />
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Regresar</a>
}
else
{
    <p class="lead">¿Está seguro de que desea eliminar este usuario?</p>
    <form asp-action="Eliminar" asp-route-id="@Model.Email" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
}
