@model Usuario
@{
    ViewData["Title"] = "Detalle de usuario";
    bool puedeEditar = ViewBag.PuedeEditar is true;
}
<h1 class="h3 mb-4"><i class="bi bi-person-vcard"></i> Detalle de usuario</h1>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>
@if (!puedeEditar)
{
    <partial name="_PropiaCuentaPartial" />
}
<div class="d-flex gap-2">
    @if (puedeEditar)
    {
        <a asp-action="Editar" asp-route-id="@Model.Email" class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Eliminar" asp-route-id="@Model.Email" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Regresar</a>
</div>
