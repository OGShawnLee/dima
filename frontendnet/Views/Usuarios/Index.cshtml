@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    string? mensaje = TempData["Mensaje"] as string;
    string? actual = User.Identity?.Name;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-people"></i> Usuarios</h1>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nuevo usuario</a>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Correo electrónico</th>
                <th>Nombre</th>
                <th>Rol</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-body-secondary">No hay usuarios para mostrar.</td></tr>
            }
            @foreach (var item in Model)
            {
                bool propio = string.Equals(actual, item.Email, StringComparison.OrdinalIgnoreCase);
                <tr>
                    <td>@item.Email @if (propio) { <span class="badge text-bg-info">Usted</span> }</td>
                    <td>@item.Nombre</td>
                    <td><span class="badge text-bg-secondary">@item.Rol</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Detalle" asp-route-id="@item.Email" class="btn btn-sm btn-outline-secondary" title="Detalle"><i class="bi bi-eye"></i></a>
                        @if (!propio)
                        {
                            <a asp-action="Editar" asp-route-id="@item.Email" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Eliminar" asp-route-id="@item.Email" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="small text-body-secondary">Mostrando @Model.Count elementos.</p>
