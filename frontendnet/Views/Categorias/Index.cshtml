@model List<Categoria>
@{
    ViewData["Title"] = "Categorías";
    string? mensaje = TempData["Mensaje"] as string;
    string? error = TempData["Error"] as string;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-tags"></i> Categorías</h1>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nueva categoría</a>
</div>

@if (mensaje is not null)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No hay categorías registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Protegida</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CategoriaId</td>
                        <td class="text-break">@c.Nombre</td>
                        <td>
                            @if (c.Protegida)
                            {
                                <span class="badge text-bg-warning"><i class="bi bi-lock"></i> Sí</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@c.CategoriaId" title="Detalle"><i class="bi bi-eye"></i><span class="visually-hidden">Detalle</span></a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@c.CategoriaId" title="Editar"><i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span></a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@c.CategoriaId" title="Eliminar"><i class="bi bi-trash"></i><span class="visually-hidden">Eliminar</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
