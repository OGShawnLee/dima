@model Categoria
@{
    ViewData["Title"] = "Detalle de categoría";
}
<h1 class="h3 mb-4"><i class="bi bi-tag"></i> Detalle de categoría</h1>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>
<a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.CategoriaId"><i class="bi bi-pencil"></i> Editar</a>
<a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Regresar</a>
