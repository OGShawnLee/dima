@model Categoria
@{
    ViewData["Title"] = "Eliminar categoría";
}
<h1 class="h3 mb-4"><i class="bi bi-trash"></i> Eliminar categoría</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <partial name="_DetallePartial" model="Model" />
    </div>
</div>

@if (Model.Protegida)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-shield-lock"></i> Esta categoría está protegida y no puede eliminarse.
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Regresar</a>
}
else
{
    <p class="text-danger">¿Está seguro de que desea eliminar esta categoría? Esta acción no se puede deshacer.</p>
    <form asp-action="Eliminar" asp-route-id="@Model.CategoriaId" method="post">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
