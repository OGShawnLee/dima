@{
    ViewData["Title"] = "Error";
    var requestId = ViewData["RequestId"] as string;
}
<div class="text-center py-5">
    <h1 class="display-5 text-danger"><i class="bi bi-exclamation-octagon"></i> Error</h1>
    <p class="lead">Ocurrió un error al procesar la solicitud.</p>
    @if (!string.IsNullOrEmpty(requestId))
    {
        <p class="text-body-secondary small">Identificador de la solicitud: <code>@requestId</code></p>
    }
    <a class="btn btn-primary" href="~/"><i class="bi bi-house"></i> Volver al inicio</a>
</div>
