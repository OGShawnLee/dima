@*
    Final menu routes for every ticket (F002–F007 must not edit Views/Shared).
    Cart badge contract: F006 stores the item count in Session key "CarritoCantidad" (Int32).
*@
<ul class="navbar-nav me-auto mb-2 mb-lg-0">
    @if (User.IsInRole("Administrador"))
    {
        <li class="nav-item"><a class="nav-link" href="~/Productos"><i class="bi bi-box-seam"></i> Productos</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Categorias"><i class="bi bi-tags"></i> Categorías</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Archivos"><i class="bi bi-images"></i> Archivos</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Usuarios"><i class="bi bi-people"></i> Usuarios</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Pedidos"><i class="bi bi-receipt"></i> Pedidos</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Bitacora"><i class="bi bi-journal-text"></i> Bitácora</a></li>
    }
    else if (User.IsInRole("Usuario"))
    {
        int cantidad = Context.Session.GetInt32("CarritoCantidad") ?? 0;
        <li class="nav-item"><a class="nav-link" href="~/Comprar"><i class="bi bi-shop"></i> Comprar</a></li>
        <li class="nav-item">
            <a class="nav-link" href="~/Carrito">
                <i class="bi bi-cart3"></i> Carrito
                <span class="badge rounded-pill text-bg-primary">@cantidad</span>
            </a>
        </li>
        <li class="nav-item"><a class="nav-link" href="~/Pedidos/Mios"><i class="bi bi-bag-check"></i> Mis pedidos</a></li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" href="~/"><i class="bi bi-house"></i> Inicio</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Registro"><i class="bi bi-person-plus"></i> Crear cuenta</a></li>
    }
</ul>
