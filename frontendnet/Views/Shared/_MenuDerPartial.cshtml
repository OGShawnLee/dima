<ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
    <li class="nav-item me-lg-3">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="darkModeSwitch" />
            <label class="form-check-label" for="darkModeSwitch"><i class="bi bi-moon-stars"></i> Modo oscuro</label>
        </div>
    </li>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item"><a class="nav-link" href="~/Perfil"><i class="bi bi-person-circle"></i> Hola @User.Identity.Name!</a></li>
        <li class="nav-item"><a class="nav-link" href="~/Auth/Salir"><i class="bi bi-box-arrow-right"></i> Salir</a></li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" href="~/Auth"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a></li>
    }
    <li class="nav-item ms-lg-2">
        <img src="~/images/netlogo.jpg" alt=".NET" height="28" class="rounded" />
    </li>
</ul>
