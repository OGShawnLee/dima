@model List<Producto>
@{
    ViewData["Title"] = "Comprar";
    string? busqueda = ViewData["Busqueda"] as string;
    bool puedeComprar = User.IsInRole("Usuario");
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-shop"></i> Comprar</h1>
    @if (puedeComprar)
    {
        <a class="btn btn-outline-primary" asp-controller="Carrito" asp-action="Index"><i class="bi bi-cart3"></i> Ver carrito</a>
    }
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <input type="search" name="s" value="@busqueda" class="form-control" maxlength="255"
               placeholder="Buscar por título" aria-label="Buscar productos" />
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Buscar</button>
        @if (busqueda is not null)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
        }
    </div>
</form>

<partial name="~/Views/Carrito/_MensajesPartial.cshtml" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (!puedeComprar)
{
    <div class="alert alert-info" role="status">Vista de catálogo: solo las cuentas de cliente pueden agregar productos al carrito.</div>
}

@if (busqueda is not null)
{
    <p class="text-body-secondary">Resultados para «<span class="text-break">@busqueda</span>»: @Model.Count</p>
}

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No se encontraron productos.</p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <partial name="~/Views/Carrito/_PortadaPartial.cshtml" model="p"
                             view-data='new ViewDataDictionary(ViewData) { ["clase"] = "card-img-top", ["ancho"] = "300" }' />
                    <div class="card-body d-flex flex-column">
                        <h2 class="card-title h6 text-break">@p.Titulo</h2>
                        <p class="card-text fw-bold mb-2">@Producto.FormatoPrecio(p.Precio)</p>
                        <div class="mb-3">
                            @foreach (var c in p.Categorias ?? [])
                            {
                                <span class="badge text-bg-secondary me-1 text-wrap">@c.Nombre</span>
                            }
                        </div>
                        @if (puedeComprar && p.ProductoId is int pid)
                        {
                            <form asp-controller="Carrito" asp-action="Agregar" method="post" class="mt-auto">
                                <input type="hidden" name="productoId" value="@pid" />
                                <input type="hidden" name="s" value="@busqueda" />
                                <div class="input-group input-group-sm">
                                    <label class="input-group-text" for="cantidad-@pid">Cant.</label>
                                    <input type="number" id="cantidad-@pid" name="cantidad" value="1" min="1" max="99" step="1"
                                           required class="form-control" />
                                    <button type="submit" class="btn btn-primary"><i class="bi bi-cart-plus"></i> Agregar</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
