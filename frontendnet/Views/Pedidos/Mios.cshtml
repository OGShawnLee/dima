@model List<Pedido>
@{
    ViewData["Title"] = "Mis pedidos";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-bag-check"></i> Mis pedidos</h1>
    <a class="btn btn-outline-primary" asp-controller="Comprar" asp-action="Index"><i class="bi bi-shop"></i> Seguir comprando</a>
</div>
<p class="text-body-secondary small">Horas en zona horaria de la Ciudad de México.</p>
<partial name="_MensajesPartial" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(m => m[0].PedidoId)</th>
                <th scope="col">@Html.DisplayNameFor(m => m[0].Fecha)</th>
                <th scope="col" class="text-end">@Html.DisplayNameFor(m => m[0].ItemCount)</th>
                <th scope="col" class="text-end">@Html.DisplayNameFor(m => m[0].Total)</th>
                <th scope="col">@Html.DisplayNameFor(m => m[0].Estado)</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary">Aún no tiene pedidos.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td><a asp-action="Detalle" asp-route-id="@p.PedidoId">#@p.PedidoId</a></td>
                    <td class="text-nowrap">@p.Fecha?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="text-end">@p.ItemCount</td>
                    <td class="text-end text-nowrap">@Producto.FormatoPrecio(p.Total)</td>
                    <td><span class="badge @Pedido.EstadoClase(p.Estado)">@Pedido.EstadoTexto(p.Estado)</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@p.PedidoId" title="Detalle"><i class="bi bi-eye"></i><span class="visually-hidden">Detalle</span></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="small text-body-secondary">Mostrando @Model.Count elementos.</p>
