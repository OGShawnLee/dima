@model PedidoDetalle
@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId}";
    bool admin = User.IsInRole("Administrador");
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-receipt"></i> Pedido #@Model.PedidoId</h1>
    @if (admin)
    {
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver a pedidos</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-action="Mios"><i class="bi bi-arrow-left"></i> Mis pedidos</a>
    }
</div>
<partial name="_MensajesPartial" />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Fecha)</dt>
    <dd class="col-sm-9">@Model.Fecha?.ToString("dd/MM/yyyy HH:mm:ss") <span class="small text-body-secondary">(Ciudad de México)</span></dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Estado)</dt>
    <dd class="col-sm-9"><span class="badge @Pedido.EstadoClase(Model.Estado)">@Pedido.EstadoTexto(Model.Estado)</span></dd>
    @if (admin)
    {
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UsuarioNombre)</dt>
        <dd class="col-sm-9 text-break">@Model.UsuarioNombre</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UsuarioEmail)</dt>
        <dd class="col-sm-9 text-break">@Model.UsuarioEmail</dd>
    }
</dl>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Producto</th>
                <th scope="col" class="text-end">Precio unitario</th>
                <th scope="col" class="text-end">Cantidad</th>
                <th scope="col" class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Items)
            {
                <tr>
                    <td class="text-break">
                        @l.Titulo
                        @if (l.ProductoId is null)
                        {
                            <span class="badge text-bg-secondary ms-1">Ya no disponible</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">@Producto.FormatoPrecio(l.PrecioUnitario)</td>
                    <td class="text-end">@l.Cantidad</td>
                    <td class="text-end text-nowrap">@Producto.FormatoPrecio(l.Subtotal)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th scope="row" colspan="3" class="text-end">Total</th>
                <td class="text-end text-nowrap fw-bold">@Producto.FormatoPrecio(Model.Total)</td>
            </tr>
        </tfoot>
    </table>
</div>
<p class="small text-body-secondary">Precios y total calculados por el servidor al confirmar el pedido.</p>
