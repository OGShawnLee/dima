<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>frontendnet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Data Protection keys and local artifacts must never be published or committed. -->
