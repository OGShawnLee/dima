[Unit]
Description=Dima frontendnet (ASP.NET Core MVC BFF)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frontendnet
Group=frontendnet
WorkingDirectory=/opt/frontendnet
ExecStart=/opt/frontendnet/frontendnet
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=frontendnet

# Non-secret configuration (no secrets are needed by the BFF itself)
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=UrlWebAPI=https://api.dima.lab
Environment=DataProtection__KeysPath=/var/lib/frontendnet/keys
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_gcServer=0

# Persistent state: Data Protection keys survive restarts so cookies stay valid.
# /var/lib/frontendnet (0700, frontendnet) is created by systemd; the app creates .../keys itself,
# and UMask=0077 makes that directory 0700 and the key files 0600.
# Keep DataProtection__KeysPath and UrlWebAPI identical to appsettings.Production.json.
StateDirectory=frontendnet
StateDirectoryMode=0700
UMask=0077
# Logs go to the journal: journalctl -u frontendnet

# Hardening (do NOT add MemoryDenyWriteExecute: it breaks the .NET JIT)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
