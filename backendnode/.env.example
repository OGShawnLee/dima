DB_HOST=localhost
DB_DATABASE=dima_db
DB_USER=change_me_db_user
DB_PASSWORD=change_me_db_password
DB_PORT=3306
# Optional MySQL TLS settings (set DB_SSL=true for remote DB encryption)
DB_SSL=false
# DB_SSL_CA=/etc/ssl/dima/dima-lab-ca.crt
# Optional host bind address (defaults to 127.0.0.1 in production, 0.0.0.0 otherwise)
# HOST=127.0.0.1
SERVER_PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_at_least_32_char_random_secret_key
FILES_IN_BD=false
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# Express trust proxy: false | true | <hop count> | <comma-separated list, e.g. loopback,10.10.10.10>
TRUST_PROXY=false
